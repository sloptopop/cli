<!--
  The Directory.Build.props `sloptopop collect` passes to `dotnet build` with
  -p:DirectoryBuildPropsPath=<this file>, from .sloptopop/tools/sonaranalyzer-csharp/.
  Nothing in the repository changes: this file first imports the repository's
  own Directory.Build.props, if there is one (which the property replaces),
  then adds SonarAnalyzer.CSharp 9.32.0.97167 (LGPL-3.0-only) from
  packages/, which fetch.proj downloads, as Roslyn analyzers, and writes the
  compiler's SARIF v2.1 log of each project to .sloptopop/reports/
  sonaranalyzer-csharp.<project>[.<target framework>].sarif.
  Written by sloptopop; MIT OR Apache-2.0, like the rest of the sloptopop CLI.
-->
<Project>
  <PropertyGroup>
    <_SloptopopOwnProps>$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildProjectDirectory)'))</_SloptopopOwnProps>
  </PropertyGroup>
  <Import Project="$(_SloptopopOwnProps)" Condition="'$(_SloptopopOwnProps)' != ''" />
  <PropertyGroup>
    <_SloptopopLog>sonaranalyzer-csharp.$(MSBuildProjectName)</_SloptopopLog>
    <_SloptopopLog Condition="'$(TargetFramework)' != ''">$(_SloptopopLog).$(TargetFramework)</_SloptopopLog>
    <ErrorLog>$([MSBuild]::NormalizePath('$(MSBuildThisFileDirectory)', '..', '..', 'reports', '$(_SloptopopLog).sarif')),version=2.1</ErrorLog>
  </PropertyGroup>
  <ItemGroup>
    <Analyzer Include="$(MSBuildThisFileDirectory)packages/sonaranalyzer.csharp/9.32.0.97167/analyzers/*.dll" />
  </ItemGroup>
</Project>
