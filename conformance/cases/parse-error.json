{
  "description": "a body that is not JSON gets a parse error with a null id; the session continues",
  "input": [
    {
      "$raw": "{not json"
    },
    {
      "jsonrpc": "2.0",
      "id": 1,
      "method": "initialize",
      "params": {
        "clientName": "conformance",
        "clientVersion": "0",
        "protocolVersion": 1
      }
    },
    {
      "jsonrpc": "2.0",
      "id": 2,
      "method": "shutdown"
    },
    {
      "jsonrpc": "2.0",
      "method": "exit"
    }
  ],
  "output": [
    {
      "jsonrpc": "2.0",
      "id": null,
      "error": {
        "code": -32700,
        "messagePrefix": "parse error: "
      }
    },
    {
      "jsonrpc": "2.0",
      "id": 1,
      "result": {
        "serverName": "sloptopop",
        "serverVersion": "$SERVER_VERSION",
        "protocolVersion": 1
      }
    },
    {
      "jsonrpc": "2.0",
      "id": 2,
      "result": null
    }
  ],
  "exitCode": 0
}
