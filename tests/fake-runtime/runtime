#!/bin/sh
# Shared body of the fake container runtimes for the collect tests: the
# stubs tests/fake-runtime/<mode>/docker and .../podman source this file,
# so $0 is the stub. Real runtimes are never needed by the tests or CI.
# PATH holds the stub's directory first, then /bin and /usr/bin.
#
# State lives in the working directory (the repository root collect runs
# the runtime from):
#   .fake-runtime-calls   every call, "<cli> <arguments>"
#   .fake-images          the references "pulled", one per line
#   .fake-versions        "<tool label> <version>" lines the tests write
#   .fake-db-version      the snapshots' date (default 20261020)
#
# Modes (the stub's directory):
#   docker      a rootful Docker 29.1.3 that answers, pulls and runs
#   rootless    the same, rootless
#   podman      a rootless Podman 5.6.0 with every cgroup controller
#   nolimits    a rootless Podman without the memory controller
#   down        `info` fails: "Cannot connect to the Docker daemon"
#   silent      `info` succeeds but prints no version
#   loaded      every image is present by ID only (loaded from an archive)
#   relabelled  every image is present, with the wrong labels
#   nopull      pulls fail: "manifest unknown"
#   lost        pulls succeed, but the store never lists the image
#   slow        every container runs until `kill` stops it
#   failing     every container exits 70 with "fake failure" on stderr
#   nodata      pulls of vulnerability snapshots fail
#   nocopy      `cp` out of a created container fails
#   nocreate    `create` fails without a word
#   badcopy     `cp` copies a `.version` directory out
cli=${0##*/}
mode=${0%/*}
mode=${mode##*/}
printf '%s %s\n' "$cli" "$*" >> .fake-runtime-calls
label() { # $1 = reference; prints the tool label and version
    repo=${1%%@*}; repo=${repo%%:*}; tool=${repo##*/}
    version=$(grep "^$tool " .fake-versions 2>/dev/null | head -1 | cut -d' ' -f2)
    echo "$tool ${version:-0}"
}
case $1 in
info)
    case $mode in
    down) echo "Cannot connect to the Docker daemon at unix:///var/run/docker.sock" >&2; exit 1 ;;
    silent) echo "||"; exit 0 ;;
    docker) echo '29.1.3|["name=seccomp,profile=builtin"]|true' ;;
    rootless) echo '29.1.3|["name=seccomp,profile=builtin","name=rootless"]|true' ;;
    podman) echo '5.6.0|true|["cpuset","cpu","io","memory","pids"]' ;;
    nolimits) echo '5.6.0|true|["cpu","pids"]' ;;
    *) echo '29.1.3|[]|true' ;;
    esac
    exit 0 ;;
image)
    shift 2; format=$2; ref=$3
    case $format in
    *'index .Config.Labels'*)
        [ "$mode" = lost ] && exit 1
        grep -qx "$ref" .fake-images 2>/dev/null || exit 1
        repo=${ref%:*}
        case $repo in *foreign*) repo=other.example/analyzers/x ;; esac
        date=$(cat .fake-db-version 2>/dev/null || echo 20261020)
        printf '["%s@sha256:%s"]|%s\n' "$repo" 0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef "$date"
        exit 0 ;;
    esac
    case $mode in
    loaded)
        case $ref in sha256:*) ;; *) exit 1 ;; esac
        printf '[]|%s|{"io.sloptopop.tool":"%s","org.opencontainers.image.version":"%s"}\n' "$ref" x y
        exit 0 ;;
    relabelled)
        printf '["%s"]|sha256:00|{"io.sloptopop.tool":"other","org.opencontainers.image.version":"9"}\n' "$ref"
        exit 0 ;;
    esac
    case $ref in sha256:*) exit 1 ;; esac
    if [ "$mode" != lost ] && grep -qx "$ref" .fake-images 2>/dev/null; then
        set -- $(label "$ref")
        printf '["%s"]|sha256:00|{"io.sloptopop.tool":"%s","org.opencontainers.image.version":"%s"}\n' "$ref" "$1" "$2"
        exit 0
    fi
    echo "Error: No such image: $ref" >&2
    exit 1 ;;
pull)
    ref=$3
    if [ "$mode" = nopull ]; then echo "Error response from daemon: manifest unknown" >&2; exit 1; fi
    case $ref in *db-*:*) [ "$mode" = nodata ] && { echo "Error: not found" >&2; exit 1; } ;; esac
    echo "$ref" >> .fake-images
    exit 0 ;;
create) [ "$mode" = nocreate ] && exit 1; exit 0 ;;
cp)
    [ "$mode" = nocopy ] && { echo "Error: no such container" >&2; exit 1; }
    mkdir -p "$3/osv-scalibr/PyPI" "$3/osv-scalibr/npm" "$3/govulndb"
    echo zip > "$3/osv-scalibr/PyPI/all.zip"
    [ "$mode" = badcopy ] && mkdir -p "$3/.version"
    exit 0 ;;
rm) exit 0 ;;
kill)
    pid=$(cat ".fake-pid-$2" 2>/dev/null) && kill -9 "$pid" 2>/dev/null
    exit 0 ;;
run)
    name= entry= image=
    shift
    while [ "$#" -gt 0 ]; do
        case $1 in
            --name) shift; name=$1 ;;
            --entrypoint) shift; entry=$1; shift; image=$1; shift; break ;;
        esac
        shift
    done
    case $mode in
    slow) echo $$ > ".fake-pid-$name"; while :; do sleep 1; done ;;
    failing) printf '\nfake failure\nsecond line\n' >&2; exit 70 ;;
    esac
    out=
    previous=
    for arg in "$@"; do
        case $previous in
            --report-path|-o|-out|--output-file) out=$arg ;;
            -r) [ "$entry" = pmd ] && out=$arg ;;
        esac
        case $arg in
            --output.sarif.path=*|--report=sarif:*) out=${arg#*=}; out=${out#sarif:} ;;
        esac
        previous=$arg
    done
    sarif='{"version":"2.1.0","runs":[{"tool":{"driver":{"name":"'"$entry"'"}},"results":[]}]}'
    case $entry in
    go|dotnet) [ "${1:-}" = build ] && echo "$sarif" > .sloptopop/reports/sonaranalyzer-csharp.Fake.sarif; exit 0 ;;
    scorecard) echo '{"checks":[{"name":"License","score":0,"reason":"license file not detected"}]}'; exit 0 ;;
    phpcs) echo '{"files":{"/src/a.php":{"messages":[{"message":"m","source":"Generic.CodeAnalysis.EmptyStatement.DetectedCatch","type":"ERROR","line":3,"column":5}]}}}'; exit 1 ;;
    pylint) echo '{"messages":[]}'; exit 0 ;;
    depcruise) echo '{"summary":{"violations":[]}}'; exit 0 ;;
    sloptopop-clang-tidy) echo "# sloptopop-clang-tidy: no compile database"; exit 0 ;;
    sloptopop-shellcheck) printf '# sloptopop-shellcheck: 1 files\n{"comments":[{"file":"install.sh","line":1,"column":1,"level":"info","code":2164,"message":"m","fix":null}]}\n'; exit 0 ;;
    sloptopop-cppcheck) printf '# sloptopop-cppcheck: no compile database\n<results version="2"><errors/></results>\n'; exit 0 ;;
    jscpd) echo "$sarif" > .sloptopop/reports/jscpd.sarif; exit 0 ;;
    opengrep|semgrep) echo '{"results":[],"errors":[]}'; exit 0 ;;
    biome) echo '{"diagnostics":[]}'; exit 1 ;;
    ruff) echo '[]' > "$out"; exit 1 ;;
    eslint) echo '{"results":[],"metadata":{}}' > "$out"; exit 1 ;;
    esac
    if [ -n "$out" ]; then echo "$sarif" > "$out"; else echo "$sarif"; fi
    case $entry in
        osv-scanner|bandit|gosec|ruff|oxlint|biome|staticcheck|golangci-lint|eslint|pmd) exit 1 ;;
        swiftlint) exit 2 ;;
    esac
    exit 0 ;;
esac
echo "fake runtime: unexpected $*" >&2
exit 64
