#!/bin/sh
# Shared body of the fake analyzers for the collect tests. The stubs in
# tests/fake-tools/<mode>/<tool> source this file, so $0 is the stub. The
# real tools are never needed by the tests or CI.
#
# The directory a stub sits in selects its behaviour:
#   findings  --version prints "<tool> 1.0.0"; otherwise writes a minimal
#             SARIF report (to the file its output flag names, or to
#             stdout) and exits with the tool's "findings found" code
#   broken    --version fails silently; otherwise prints "fake failure"
#             on stderr and exits 70
#   killed    answers --version, otherwise dies from a signal
# Every call first appends "<stub> <arguments>" to .fake-calls in the
# working directory, so tests can check the argv and the directory.
# A docker stub then acts as the tool named by --entrypoint, with the
# arguments after the image (the one holding "@sha256:").
# Only shell builtins are used, so PATH may hold nothing but the stubs.
name=${0##*/}
mode=${0%/*}
mode=${mode##*/}
printf '%s %s\n' "$name" "$*" >> .fake-calls
if [ "$name" = docker ]; then
    while [ "$#" -gt 0 ]; do
        case $1 in
            --entrypoint) shift; name=$1 ;;
            *@sha256:*) shift; break ;;
        esac
        shift
    done
fi
if [ "${1:-}" = --version ]; then
    if [ "$mode" = broken ]; then
        exit 1
    fi
    printf '%s 1.0.0\nbuilt for tests\n' "$name"
    exit 0
fi
case $mode in
    broken)
        printf '\nfake failure\nsecond line\n' >&2
        exit 70
        ;;
    killed)
        kill -9 $$
        ;;
esac
out=
previous=
for arg in "$@"; do
    case $previous in
        --report-path|-o|-out|--output-file) out=$arg ;;
    esac
    case $arg in
        --output.sarif.path=*) out=${arg#*=} ;;
    esac
    previous=$arg
done
report='{"version":"2.1.0","runs":[{"tool":{"driver":{"name":"'"$name"'"}},"results":[]}]}'
if [ -n "$out" ]; then
    printf '%s\n' "$report" > "$out"
else
    printf '%s\n' "$report"
fi
case $name in
    osv-scanner|bandit|gosec|ruff|oxlint|biome|staticcheck|golangci-lint) exit 1 ;;
    swiftlint) exit 2 ;;
    govulncheck) exit 3 ;;
esac
exit 0
